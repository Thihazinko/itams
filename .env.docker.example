# =============================================================================
# Production .env template for the Dockerized ITAMS / infra-ninja stack
# -----------------------------------------------------------------------------
# Copy to .env on the deploy host, then fill in the FIXME values.
# Never commit a real .env.  chmod 600 .env after writing it.
#
#   cp .env.docker.example .env
#   chmod 600 .env
#   # generate strong passwords:
#   tr -dc 'A-Za-z0-9_.-' </dev/urandom | head -c 24
#   # generate APP_KEY (run once after `docker compose build`):
#   APP_KEY=$(docker compose run --rm --no-deps app php artisan key:generate --show)
#   sed -i "s|^APP_KEY=.*|APP_KEY=${APP_KEY}|" .env
# =============================================================================

APP_NAME="ITAMS - IT Assets Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Yangon
APP_URL=https://itams.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# DB_HOST must be the compose service name (`db`), not 127.0.0.1.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rrs_system
DB_USERNAME=infraninja
DB_PASSWORD=FIXME_generate_strong_password
DB_ROOT_PASSWORD=FIXME_generate_strong_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only set true once HTTPS is live in front of the stack.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@itams.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Optional: override the nginx host port (default 80).
# HTTP_PORT=80
